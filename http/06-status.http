# 지원 상태 변경
# 흐름: 회사·지원내역 준비 → 상태 변경·조회 → 다른 정보 수정·조회 → 잘못된 상태 거절·조회 → 삭제·조회 → 없는 대상 확인 → 회사 정리·조회
# 서버를 실행하고 1번부터 위→아래로 실행한다. 다른 파일을 먼저 실행할 필요는 없다.
# 각 요청의 응답 처리 코드가 예상 결과를 검사한다. 실패하면 멈추고 응답을 확인한다.
# 등록 응답의 ID를 자동 저장하며, 이 파일에서 만든 데이터만 수정·삭제한다.

@baseUrl = http://localhost:8080

### 1. 준비: 테스트 회사 등록 — 201 예상
< {%
    client.global.clear("jt_status_company_id");
    client.global.clear("jt_status_application_id");
%}
POST {{baseUrl}}/api/companies
Content-Type: application/json

{
  "name": "지원 상태 테스트 회사",
  "location": "성남"
}

> {%
    client.assert(response.status === 201, "회사 등록은 201이어야 해.");
    client.assert(response.body.id != null, "회사 ID가 필요해.");
    client.global.set("jt_status_company_id", response.body.id);
%}

### 2. 준비: 지원내역 등록, 첫 상태 APPLIED 확인 — 201 예상
POST {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Content-Type: application/json

{
  "jobTitle": "백엔드 개발자",
  "appliedAt": "2026-10-03",
  "memo": "지원 상태 변경 테스트"
}

> {%
    client.assert(response.status === 201, "지원내역 등록은 201이어야 해.");
    client.assert(response.body.id != null, "지원내역 ID가 필요해.");
    client.assert(response.body.status === "APPLIED", "새 지원내역은 지원완료여야 해.");
    client.global.set("jt_status_application_id", response.body.id);
%}

### 3. 등록 확인: 조회에서도 APPLIED인지 보기 — 200 예상
GET {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Accept: application/json

> {%
    client.assert(response.status === 200, "조회는 200이어야 해.");
    client.assert(response.body.length === 1, "지원내역이 한 건이어야 해.");
    client.assert(response.body[0].status === "APPLIED", "저장된 첫 상태는 APPLIED여야 해.");
%}

### 4. 상태만 면접으로 변경 — 200 예상
# 직무·날짜·메모는 보내지 않는다. 이 요청은 상태만 변경한다.
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}/status
Content-Type: application/json

{
  "status": "INTERVIEW"
}

> {%
    client.assert(response.status === 200, "상태 변경은 200이어야 해.");
    client.assert(response.body.status === "INTERVIEW", "상태가 면접으로 바뀌어야 해.");
%}

### 5. 변경 확인: 면접 상태 저장, 나머지 정보 유지 — 200 예상
GET {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.length === 1, "지원내역 한 건을 조회해야 해.");
    const app = response.body[0];
    client.assert(app.id == client.global.get("jt_status_application_id"), "지원내역 ID는 유지돼야 해.");
    client.assert(app.companyId == client.global.get("jt_status_company_id"), "회사 연결은 유지돼야 해.");
    client.assert(app.status === "INTERVIEW", "조회에서도 면접 상태여야 해.");
    client.assert(app.jobTitle === "백엔드 개발자" && app.appliedAt === "2026-10-03" && app.memo === "지원 상태 변경 테스트", "직무·날짜·메모는 바뀌면 안 돼.");
%}

### 6. 직무·날짜·메모 수정 — 200 예상
# 기존 수정 API도 상태를 지원완료로 되돌리면 안 된다.
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}
Content-Type: application/json

{
  "jobTitle": "기술지원",
  "appliedAt": "2026-10-02",
  "memo": "면접 일정 확인 완료"
}

> {%
    client.assert(response.status === 200, "정보 수정은 200이어야 해.");
    client.assert(response.body.status === "INTERVIEW", "다른 정보 수정 시 면접 상태는 유지돼야 해.");
%}

### 7. 수정 확인: 다른 정보만 수정되고 상태 유지 — 200 예상
GET {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.length === 1, "지원내역 한 건을 조회해야 해.");
    const app = response.body[0];
    client.assert(app.status === "INTERVIEW", "면접 상태는 유지돼야 해.");
    client.assert(app.jobTitle === "기술지원" && app.appliedAt === "2026-10-02" && app.memo === "면접 일정 확인 완료", "수정한 직무·날짜·메모가 저장돼야 해.");
%}

### 8. 검증: 상태 null 거절 — 400 예상
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}/status
Content-Type: application/json

{
  "status": null
}

> {%
    client.assert(response.status === 400, "null 상태는 거절해야 해.");
%}

### 9. 검증: 상태 누락 거절 — 400 예상
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}/status
Content-Type: application/json

{}

> {%
    client.assert(response.status === 400, "상태 누락은 거절해야 해.");
%}

### 10. 검증: enum에 없는 상태 거절 — 400 예상
# UNKNOWN은 JobApplicationStatus에 정의되지 않은 값이다.
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}/status
Content-Type: application/json

{
  "status": "UNKNOWN"
}

> {%
    client.assert(response.status === 400, "정의하지 않은 상태는 거절해야 해.");
%}

### 11. 거절 결과 확인: 기존 상태와 정보 유지 — 200 예상
GET {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.length === 1, "지원내역 한 건을 조회해야 해.");
    const app = response.body[0];
    client.assert(app.status === "INTERVIEW", "잘못된 요청 뒤에도 면접 상태가 유지돼야 해.");
    client.assert(app.jobTitle === "기술지원" && app.appliedAt === "2026-10-02" && app.memo === "면접 일정 확인 완료", "기존 정보도 유지돼야 해.");
%}

### 12. 상태 재변경: 최종합격 — 200 예상
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}/status
Content-Type: application/json

{
  "status": "ACCEPTED"
}

> {%
    client.assert(response.status === 200, "상태 재변경은 200이어야 해.");
    client.assert(response.body.status === "ACCEPTED", "최종합격으로 바뀌어야 해.");
%}

### 13. 재변경 확인: 최종합격 상태 저장 — 200 예상
GET {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.length === 1, "지원내역 한 건을 조회해야 해.");
    const app = response.body[0];
    client.assert(app.status === "ACCEPTED", "조회에서도 최종합격이어야 해.");
    client.assert(app.jobTitle === "기술지원" && app.appliedAt === "2026-10-02" && app.memo === "면접 일정 확인 완료", "상태 재변경 시 다른 정보는 유지돼야 해.");
%}

### 14. 정리: 테스트 지원내역 삭제 — 204 예상
DELETE {{baseUrl}}/api/job-applications/{{jt_status_application_id}}

> {%
    client.assert(response.status === 204, "지원내역 삭제는 204여야 해.");
%}

### 15. 삭제 확인: 지원내역 빈 목록 — 200 예상
GET {{baseUrl}}/api/companies/{{jt_status_company_id}}/job-applications
Accept: application/json

> {%
    client.assert(response.status === 200 && response.body.length === 0, "삭제한 지원내역이 남으면 안 돼.");
%}

### 16. 없는 대상: 삭제한 지원내역의 상태 변경 — 404 예상
PATCH {{baseUrl}}/api/job-applications/{{jt_status_application_id}}/status
Content-Type: application/json

{
  "status": "INTERVIEW"
}

> {%
    client.assert(response.status === 404, "삭제한 지원내역의 상태를 바꾸려 하면 404여야 해.");
%}

### 17. 정리: 테스트 회사 삭제 — 204 예상
DELETE {{baseUrl}}/api/companies/{{jt_status_company_id}}

> {%
    client.assert(response.status === 204, "회사 삭제는 204여야 해.");
%}

### 18. 최종 확인: 테스트 회사가 목록에서 사라졌는지 조회 — 200 예상
GET {{baseUrl}}/api/companies
Accept: application/json

> {%
    client.assert(response.status === 200, "회사 목록 조회는 200이어야 해.");
    client.assert(!response.body.some(company => company.id == client.global.get("jt_status_company_id")), "테스트 회사가 남으면 안 돼.");
%}
