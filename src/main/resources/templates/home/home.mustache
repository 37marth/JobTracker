
<h1>JobTracker</h1>

<h2>회사 등록</h2>

<div>
    <label for="company-name">회사 이름</label>
    <input type="text" id="company-name">
</div>

<div>
    <label for="company-location">위치</label>
    <input type="text" id="company-location">
</div>

<button type="button" id="company-create-btn">등록</button>


<h2>회사 목록</h2>

{{#companies}}
    <!-- details와 summary: 회사 이름을 누르면 지원내역을 펼치고 다시 누르면 접음. -->
    <details id="company-{{id}}">
        <summary>
            <strong>{{name}}</strong> — 지원내역 보기<br>
            위치: {{location}}
        </summary>

        <div id="company-detail-{{id}}">
            <button type="button"
                    id="company-edit-btn-{{id}}"
                    class="company-edit-btn"
                    data-company-id="{{id}}">
                회사 정보 수정
            </button>

            <!-- 수정 버튼을 누르기 전에는 입력칸과 저장·취소 버튼을 숨긴다. -->
            <div id="company-edit-form-{{id}}" hidden>
                <h4>회사 정보 수정</h4>

                <div>
                    <label for="company-edit-name-{{id}}">회사 이름</label>
                    <input type="text"
                           id="company-edit-name-{{id}}"
                           value="{{name}}">
                </div>

                <div>
                    <label for="company-edit-location-{{id}}">위치</label>
                    <input type="text"
                           id="company-edit-location-{{id}}"
                           value="{{location}}">
                </div>

                <button type="button"
                        class="company-update-btn"
                        data-company-id="{{id}}">
                    저장
                </button>

                <button type="button"
                        class="company-edit-cancel-btn"
                        data-company-id="{{id}}">
                    취소
                </button>
            </div>

            <hr>
            <h4>지원내역</h4>
            <hr>
            <div id="application-list-{{id}}">
                <!-- 현재 회사에 담긴 지원내역 목록을 Mustache가 반복해서 출력함. -->
                {{#applications}}
                    <!-- applications 반복 안에서 id는 회사 ID가 아니라 현재 지원내역 ID. -->
                    <article id="job-application-{{id}}">
                        <h5>직무: {{jobTitle}}</h5>
                        <p>지원 날짜: {{appliedAt}}</p>
                        <label for="application-status-{{id}}">지원 상태</label>
                        <select id="application-status-{{id}}"
                                class="application-status-select"
                                data-application-id="{{id}}"
                                data-company-id="{{companyId}}"
                                data-status="{{status}}">
                            <option value="APPLIED">지원완료</option>
                            <option value="DOCUMENT_PASS">서류합격</option>
                            <option value="INTERVIEW">면접</option>
                            <option value="ACCEPTED">최종합격</option>
                            <option value="REJECTED">불합격</option>
                            <option value="WITHDRAWN">지원취소</option>
                        </select>
                        {{#memo}}
                            <p>메모: {{memo}}</p>
                        {{/memo}}
                        {{^memo}}
                            <p>메모: 없음</p>
                        {{/memo}}
                        <button type="button"
                                id="application-edit-btn-{{id}}"
                                class="application-edit-btn"
                                data-application-id="{{id}}">
                            지원내역 수정
                        </button>

                        <!-- 수정 버튼을 누르면 보여줄 입력 영역. -->
                        <div id="application-edit-form-{{id}}" hidden>
                            <div>
                                <label for="application-edit-job-title-{{id}}">지원 직무</label>
                                <input type="text"
                                       id="application-edit-job-title-{{id}}"
                                       value="{{jobTitle}}">
                            </div>

                            <div>
                                <label for="application-edit-date-{{id}}">지원 날짜</label>
                                <!-- 수정할 때는 오늘 날짜가 아니라 기존 지원 날짜(appliedAt)를 채운다. -->
                                <input type="date"
                                       id="application-edit-date-{{id}}"
                                       value="{{appliedAt}}">
                            </div>

                            <div>
                                <label for="application-edit-memo-{{id}}">메모</label>
                                <!-- textarea는 value 속성 대신 여는 태그와 닫는 태그 사이에 기존 메모를 넣는다. -->
                                <textarea id="application-edit-memo-{{id}}">{{memo}}</textarea>
                            </div>

                            <button type="button"
                                    class="application-update-btn"
                                    data-application-id="{{id}}"
                                    data-company-id="{{companyId}}">
                                저장
                            </button>

                            <button type="button"
                                    class="application-edit-cancel-btn"
                                    data-application-id="{{id}}">
                                취소
                            </button>
                        </div>
                        <hr>
                    </article>
                {{/applications}}
                {{^applications}}
                    <p>등록된 지원내역이 없습니다.</p>
                {{/applications}}
            </div>
            <!-- 현재 회사에 지원내역을 추가하기 위한 입력칸. -->
            <h4>지원내역 등록</h4>

            <div>
                <label for="application-job-title-{{id}}">지원 직무</label>
                <input type="text" id="application-job-title-{{id}}">
            </div>

            <div>
                <label for="application-date-{{id}}">지원 날짜</label>
                <input type="date" id="application-date-{{id}}" value="{{today}}">
            </div>

            <div>
                <label for="application-memo-{{id}}">메모</label>
                <textarea id="application-memo-{{id}}"></textarea>
            </div>

            <button type="button"
                    class="application-create-btn"
                    data-company-id="{{id}}">
                지원내역 등록
            </button>
        </div>
    </details>
{{/companies}}

{{^companies}}
    <p>등록된 회사가 없습니다.</p>
{{/companies}}

<script>
    // 기능 목차: 아래 번호와 같은 region 제목을 찾아 해당 기능만 읽는다.
    // 01. 새로고침 후 회사 펼치기
    // 02. 회사 등록
    // 03. 지원내역 등록
    // 04. 지원 상태 변경
    // 05. 회사 수정칸 열기
    // 06. 회사 수정 취소
    // 07. 회사 수정 저장
    // 08. 지원내역 수정칸 열기
    // 09. 지원내역 수정 취소
    // 10. 지원내역 수정 저장
    // 버튼에 이벤트를 연결하는 코드는 페이지가 열릴 때 실행된다.
    // click/change 함수 안의 코드는 실제 클릭/선택 변경 후 실행된다.

    //region 01. 새로고침 후 회사 펼치기 — 시작
    // 주소의 # 뒤에 기록된 회사가 있으면 새로고침 후에도 펼쳐서 표시한다.
    const companyToOpen = document.getElementById(window.location.hash.substring(1));
    if (companyToOpen !== null && companyToOpen.tagName === "DETAILS") {
        companyToOpen.open = true;
    }
    //endregion 01. 새로고침 후 회사 펼치기 — 끝

    //region 02. 회사 등록 — 시작
    // HTML에서 등록 버튼을 찾는다.
    const createButton = document.querySelector("#company-create-btn");

    // 등록 버튼을 클릭하면 이 함수를 실행한다.
    createButton.addEventListener("click",async function () {
        // 회사 이름 입력칸을 찾아 입력된 값을 읽는다.
        const name = document.querySelector("#company-name").value;

        // 위치 입력칸을 찾아 입력된 값을 읽는다.
        const location = document.querySelector("#company-location").value;

        // 입력값 두 개를 회사 등록용 객체에 담는다.
        const company = {
            name: name,
            location: location
        };

        // 객체를 서버에 보낼 JSON 문자열로 바꾼다.
        const requestBody = JSON.stringify(company);

        const url = "/api/companies";

        // 회사 등록 API에 JSON을 보내고 응답을 기다린다.
        const response = await fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: requestBody
        });

        if (response.status === 201) {
            // 등록 성공 시 현재 페이지를 새로고침한다.
            window.location.reload();
        } else {
            alert("회사 등록 실패! 응답 상태: " + response.status);
        }
    });
    //endregion 02. 회사 등록 — 끝

    //region 03. 지원내역 등록 — 시작
    // 모든 회사의 지원내역 등록 버튼을 찾는다.
    const applicationCreateButtons =
            document.querySelectorAll(".application-create-btn");

    // 버튼을 하나씩 꺼내 클릭했을 때 실행할 함수를 연결한다.
    for (const button of applicationCreateButtons) {
        button.addEventListener("click", function () {
            // 클릭한 버튼에 기록된 회사 ID를 읽는다.
            const companyId = button.dataset.companyId;

            // 해당 회사의 입력칸에서 값을 읽는다.
            const jobTitle = document.querySelector(
                    "#application-job-title-" + companyId).value;
            const appliedAt = document.querySelector(
                    "#application-date-" + companyId).value;
            const memo = document.querySelector(
                    "#application-memo-" + companyId).value;

            // 지원내역 등록에 사용할 값을 객체에 담는다.
            const application = {
                jobTitle: jobTitle,
                appliedAt: appliedAt,
                memo: memo
            };

            // 입력값 객체를 서버에 보낼 JSON 문자열로 바꾼다.
            const requestBody = JSON.stringify(application);

            // 클릭한 회사의 지원내역 등록 주소를 만든다.
            const url = "/api/companies/" + companyId + "/job-applications";

            // 지원내역 등록 요청을 보낸다.
            fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: requestBody
            }).then(function (response) {
                // 서버 응답을 받으면 상태 코드를 확인한다.
                if (response.status === 201) {
                    // 등록한 회사의 위치를 주소에 기록하고, 최신 지원내역을 다시 표시한다.
                    window.location.hash = "company-" + companyId;
                    window.location.reload();
                } else {
                    alert("지원내역 등록 실패! 응답 상태: " + response.status);
                }
            });
        });
    }

    //endregion 03. 지원내역 등록 — 끝

    //region 04. 지원 상태 변경 — 시작
    // 모든 지원내역의 상태 선택칸을 찾는다.
    const statusSelects =
            document.querySelectorAll(".application-status-select");

    // 각 선택칸에 현재 저장된 상태를 선택해둔다.
    for (const statusSelect of statusSelects) {
        // 처음에는 DB에 저장된 상태를 선택해둔다.
        statusSelect.value = statusSelect.dataset.status;

        // 사용자가 다른 상태를 선택하면 실행한다.
        statusSelect.addEventListener("change", function () {
            const applicationId = statusSelect.dataset.applicationId;
            const companyId = statusSelect.dataset.companyId;

            // 선택한 상태만 요청 객체에 담는다.
            const statusRequest = {
                status: statusSelect.value
            };

            const url = "/api/job-applications/" + applicationId + "/status";

            fetch(url, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(statusRequest)
            }).then(function (response) {
                if (response.status === 200) {
                    // 변경 결과를 다시 조회하고 같은 회사를 펼쳐둔다.
                    window.location.hash = "company-" + companyId;
                    window.location.reload();
                } else {
                    // 서버가 변경을 거절하면 선택칸을 기존 상태로 되돌린다.
                    statusSelect.value = statusSelect.dataset.status;
                    alert("상태 변경 실패! 응답 상태: " + response.status);
                }
            });
        });
    }

    //endregion 04. 지원 상태 변경 — 끝

    //region 05. 회사 수정칸 열기 — 시작
    // 수정 버튼을 누르면 해당 회사의 입력칸을 보여준다.
    const companyEditButtons = document.querySelectorAll(".company-edit-btn");
    for (const button of companyEditButtons) {
        button.addEventListener("click", function () {
            const companyId = button.dataset.companyId;
            document.getElementById("company-edit-form-" + companyId).hidden = false;
            button.hidden = true;
            document.getElementById("company-edit-name-" + companyId).focus();
        });
    }

    //endregion 05. 회사 수정칸 열기 — 끝

    //region 06. 회사 수정 취소 — 시작
    // 취소하면 입력값을 원래대로 되돌리고 수정 영역을 숨긴다. 서버 요청은 보내지 않는다.
    const companyEditCancelButtons = document.querySelectorAll(".company-edit-cancel-btn");
    for (const button of companyEditCancelButtons) {
        button.addEventListener("click", function () {
            const companyId = button.dataset.companyId;
            const nameInput = document.getElementById("company-edit-name-" + companyId);
            const locationInput = document.getElementById("company-edit-location-" + companyId);
            // defaultValue: 서버가 HTML의 value에 넣어준 기존 값.
            nameInput.value = nameInput.defaultValue;
            locationInput.value = locationInput.defaultValue;
            document.getElementById("company-edit-form-" + companyId).hidden = true;
            const editButton = document.getElementById("company-edit-btn-" + companyId);
            editButton.hidden = false;
            editButton.focus();
        });
    }

    //endregion 06. 회사 수정 취소 — 끝

    //region 07. 회사 수정 저장 — 시작
    // 회사 정보 저장 버튼들을 찾는다.
    const companyUpdateButtons =
            document.querySelectorAll(".company-update-btn");

    for (const button of companyUpdateButtons) {
        button.addEventListener("click", function () {
            // 클릭한 버튼의 회사 ID를 읽는다.
            const companyId = button.dataset.companyId;

            // 해당 회사의 수정 입력칸에서 값을 읽는다.
            const company = {
                name: document.querySelector(
                        "#company-edit-name-" + companyId).value,
                location: document.querySelector(
                        "#company-edit-location-" + companyId).value
            };

            // 수정할 회사의 주소를 만든다.
            const url = "/api/companies/" + companyId;

            fetch(url, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(company)
            }).then(function (response) {
                if (response.status === 200) {
                    // 수정된 정보를 다시 불러오고 같은 회사를 펼쳐둔다.
                    window.location.hash = "company-" + companyId;
                    window.location.reload();
                } else {
                    alert("회사 수정 실패! 응답 상태: " + response.status);
                }
            });
        });
    }
    //endregion 07. 회사 수정 저장 — 끝

    //region 08. 지원내역 수정칸 열기 — 시작
    // 모든 지원내역 수정 버튼을 찾는다.
    const applicationEditButtons =
            document.querySelectorAll(".application-edit-btn");

    for (const button of applicationEditButtons) {
        button.addEventListener("click", function () {
            // 클릭한 버튼의 지원내역 ID를 읽는다.
            const applicationId = button.dataset.applicationId;

            // 해당 지원내역의 수정 입력칸을 보여준다.
            document.getElementById(
                    "application-edit-form-" + applicationId).hidden = false;

            // 입력칸을 열었으므로 수정 버튼은 잠시 숨긴다.
            button.hidden = true;
        });
    }

    //endregion 08. 지원내역 수정칸 열기 — 끝

    //region 09. 지원내역 수정 취소 — 시작
    // 모든 지원내역 수정 취소 버튼을 찾는다.
    const applicationEditCancelButtons =
            document.querySelectorAll(".application-edit-cancel-btn");

    for (const button of applicationEditCancelButtons) {
        button.addEventListener("click", function () {
            const applicationId = button.dataset.applicationId;

            const jobTitleInput = document.getElementById(
                    "application-edit-job-title-" + applicationId);
            const dateInput = document.getElementById(
                    "application-edit-date-" + applicationId);
            const memoInput = document.getElementById(
                    "application-edit-memo-" + applicationId);

            // defaultValue: 처음 화면을 받았을 때 채워져 있던 기존 값.
            jobTitleInput.value = jobTitleInput.defaultValue;
            dateInput.value = dateInput.defaultValue;
            memoInput.value = memoInput.defaultValue;

            // 입력칸을 닫고 수정 버튼을 다시 보여준다.
            document.getElementById(
                    "application-edit-form-" + applicationId).hidden = true;
            document.getElementById(
                    "application-edit-btn-" + applicationId).hidden = false;
        });
    }

    //endregion 09. 지원내역 수정 취소 — 끝

    //region 10. 지원내역 수정 저장 — 시작
    // 모든 지원내역 저장 버튼을 찾는다.
    const applicationUpdateButtons =
            document.querySelectorAll(".application-update-btn");

    for (const button of applicationUpdateButtons) {
        button.addEventListener("click", function () {
            // 지원내역 ID는 수정 요청에, 회사 ID는 다시 펼칠 위치에 사용한다.
            const applicationId = button.dataset.applicationId;
            const companyId = button.dataset.companyId;

            // 수정 입력칸에서 직무·날짜·메모를 함께 읽는다.
            const application = {
                jobTitle: document.getElementById(
                        "application-edit-job-title-" + applicationId).value,
                appliedAt: document.getElementById(
                        "application-edit-date-" + applicationId).value,
                memo: document.getElementById(
                        "application-edit-memo-" + applicationId).value
            };

            const url = "/api/job-applications/" + applicationId;

            fetch(url, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(application)
            }).then(function (response) {
                if (response.status === 200) {
                    // 저장한 결과를 다시 불러오고 같은 회사를 펼쳐둔다.
                    window.location.hash = "company-" + companyId;
                    window.location.reload();
                } else {
                    alert("지원내역 수정 실패! 응답 상태: " + response.status);
                }
            });
        });
    }
    //endregion 10. 지원내역 수정 저장 — 끝
</script>
